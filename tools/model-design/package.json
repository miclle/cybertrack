{
  "name": "cybertrack-model-design",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node dist/build-plugin.js",
    "start": "npm run build && node dist/server.js",
    "test": "npm run build && node --test model.test.mjs geometry.test.mjs history.test.mjs history.integration.test.mjs spacer.test.mjs spacer.integration.test.mjs spacer-update.integration.test.mjs plate.test.mjs plate.integration.test.mjs plate-update.integration.test.mjs delivery.test.mjs build.integration.test.mjs cad-bridge.integration.test.mjs assembly-sync.test.mjs state-codec.test.mjs",
    "build:plugin": "npm run build && node dist/build-plugin.js --plugin",
    "test:geometry": ".venv/bin/python -m unittest geometry_test.py",
    "test:plugin": "node --test mcp.test.mjs",
    "test:bundle": "npm run build:plugin && node --test bundle.test.mjs",
    "test:ui": "npm run build:plugin && node --test ui.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.2.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
