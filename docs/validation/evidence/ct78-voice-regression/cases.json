{
  "scope": "26 single-turn cases and four same-connection recovery scenarios; synthetic Mandarin, real platform STT, actual ct78 host; no device IO",
  "cases": [
    {
      "id": "B01",
      "text": "前进两秒，同时喷水一秒",
      "context": "设备在线、空闲，四路关闭且不在冷却；网页未占用；距离有效且未锁定",
      "category": "combination",
      "expected_calls": [
        {
          "name": "self.tank.move_and_water",
          "arguments": {
            "direction": "forward",
            "move_duration_ms": 2000,
            "water_duration_ms": 1000
          }
        }
      ],
      "response_expectation": "成功后不输出确认或过程播报"
    },
